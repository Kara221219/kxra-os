{
  "name": "kxra-genesis-os",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#kxra/local-guard": {
      "development": "./packages/authz/local-guard.ts",
      "default": "./packages/authz/local-guard.production.ts"
    }
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/local.mjs",
    "dev:os": "npm run dev -w @kxra/os",
    "dev:marketing": "npm run dev -w @kxra/marketing",
    "build": "npm run build:os && npm run build:marketing",
    "build:os": "npm run build -w @kxra/os",
    "build:marketing": "npm run build -w @kxra/marketing",
    "start": "npm run start -w @kxra/os",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:artifact": "node scripts/verify-production-artifact.mjs",
    "test:marketing": "playwright test -c playwright.marketing.config.ts",
    "test:publication": "node scripts/verify-publication-snapshot.mjs",
    "test:marketing-boundary": "node scripts/verify-marketing-boundary.mjs",
    "test:restart": "node scripts/verify-persistence.mjs",
    "test:restore": "node scripts/verify-backup-restore.mjs",
    "worker:files": "tsx scripts/file-worker.ts --once",
    "worker:files:watch": "tsx scripts/file-worker.ts --watch",
    "worker:files:reconcile": "tsx scripts/file-worker.ts --reconcile",
    "db:start": "node scripts/database.mjs start",
    "db:stop": "node scripts/database.mjs stop",
    "db:reset": "node scripts/database.mjs reset",
    "test:e2e": "playwright test",
    "test:migrations": "node scripts/verify-migrations.mjs",
    "test:secrets": "node scripts/verify-secrets.mjs",
    "test:dependencies": "node scripts/verify-dependencies.mjs",
    "test:ci": "node scripts/ci.mjs",
    "lint": "npm run typecheck && npm run format:check",
    "check": "npm run lint && npm run test:dependencies && npm test && npm run test:migrations && npm run test:publication && npm run test:marketing-boundary && npm run build && npm run test:artifact && npm run test:secrets",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,mjs,css}\" \"packages/**/*.ts\" \"scripts/*.{mjs,ts}\" \"tests/**/*.ts\" \"playwright*.ts\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
