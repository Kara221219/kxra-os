# No real credentials. npm run dev creates isolated local fixture configuration.
KXRA_ENVIRONMENT=local
# Operator-only staging migration values. Never add these to Vercel or Git.
KXRA_STAGING_PROJECT_REF=
KXRA_STAGING_MIGRATOR_DATABASE_URL=
KXRA_STAGING_MIGRATION_CONFIRMATION=
KXRA_STAGING_SEED_CONFIRMATION=
KXRA_STAGING_APP_PASSWORD=
KXRA_STAGING_PUBLIC_INGRESS_PASSWORD=
KXRA_STAGING_ROLE_CONFIRMATION=
KXRA_STAGING_EMAIL_WORKER_PASSWORD=
KXRA_STAGING_EMAIL_WORKER_ROLE_CONFIRMATION=
KXRA_STAGING_BILLING_WORKER_PASSWORD=
KXRA_STAGING_BILLING_WORKER_ROLE_CONFIRMATION=
KXRA_STAGING_OWNER_USER_ID=
KXRA_STAGING_OWNER_EMAIL=
KXRA_STAGING_OWNER_DISPLAY_NAME=
KXRA_STAGING_OWNER_CONFIRMATION=
# Operator-only production initialization values. Keep these out of Vercel and
# local files; inject them only for one guarded plan/apply/verify invocation.
KXRA_PRODUCTION_PROJECT_REF=
KXRA_PRODUCTION_SOURCE_COMMIT=
KXRA_PRODUCTION_MIGRATOR_DATABASE_URL=
KXRA_PRODUCTION_DATABASE_CA_CERT_BASE64=
KXRA_PRODUCTION_MIGRATION_CONFIRMATION=
KXRA_PRODUCTION_APP_PASSWORD=
KXRA_PRODUCTION_PUBLIC_INGRESS_PASSWORD=
KXRA_PRODUCTION_EMAIL_WORKER_PASSWORD=
KXRA_PRODUCTION_BILLING_WORKER_PASSWORD=
KXRA_PRODUCTION_BOOTSTRAP_CONFIRMATION=
KXRA_PRODUCTION_OWNER_USER_ID=
KXRA_PRODUCTION_OWNER_EMAIL=
KXRA_PRODUCTION_OWNER_DISPLAY_NAME=
KXRA_PRODUCTION_OWNER_CONFIRMATION=
# VERCEL, VERCEL_ENV and VERCEL_TARGET_ENV are trusted provider system values;
# do not set them in local files.
KXRA_AUTH_MODE=supabase
KXRA_ORIGIN=http://localhost:3210
KXRA_MARKETING_ORIGIN=http://localhost:3220
# Marketing has a narrow server-only public-ingress connection. In hosted
# environments use the dedicated least-privilege ingress role, never postgres,
# service_role or the private OS connection.
KXRA_PUBLIC_DATABASE_URL=
KXRA_PUBLIC_INGRESS_SECRET=REPLACE_WITH_GENERATED_SERVER_ONLY_SECRET
KXRA_PRIVATE_APP_URL=http://localhost:3210/login
# Independent server-only secret for encrypted join intents (at least 64 chars).
KXRA_JOIN_SECRET=REPLACE_WITH_GENERATED_SERVER_ONLY_SECRET
DATABASE_URL=postgresql://kxra_app:REPLACE_WITH_PRIVATE_ROLE_PASSWORD@localhost:5432/postgres
KXRA_DATABASE_CA_CERT_BASE64=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# Supabase legacy JWT keys are not supported. Use sb_publishable_... in the
# browser and component-specific sb_secret_... keys only in server/worker stores.
# Future integrations are disabled; do not add keys to client bundles.
KXRA_AI_ENABLED=false
KXRA_WHATSAPP_ENABLED=false
# Private Storage remains disabled until a private bucket and restricted worker
# database role are configured in staging. Never expose either secret to a client.
KXRA_STORAGE_ENABLED=false
KXRA_STORAGE_BUCKET=kxra-private
SUPABASE_STORAGE_SECRET_KEY=
KXRA_WORKER_DATABASE_URL=
# Restricted server-only connection whose login role may SET ROLE to
# kxra_ai_worker. The AI worker role itself is NOLOGIN and has only bounded
# execution-function grants.
KXRA_AI_WORKER_DATABASE_URL=
# Public website acquisition is disabled until its separate no-bypass worker
# connection is configured and SSRF/egress controls pass staging acceptance.
KXRA_PUBLIC_WEB_ENABLED=false
KXRA_BRAND_SOURCE_WORKER_DATABASE_URL=
# Billing remains disabled until the exact test-mode activation is reviewed.
KXRA_BILLING_ENABLED=false
# Restricted server-only connection whose login may SET ROLE to the no-login,
# no-bypass kxra_billing_worker role. Test-mode Stripe only until release approval.
KXRA_BILLING_WORKER_DATABASE_URL=
# Prefer a least-privilege Stripe restricted test key (rk_test_...). A standard
# test secret (sk_test_...) is accepted only when restricted keys cannot cover
# the reviewed hosted Checkout, Portal and Customer operations.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
TRIGGER_SECRET_KEY=
# Transactional email is disabled until the dedicated no-bypass worker,
# verified sender and controlled staging recipient have passed acceptance.
KXRA_EMAIL_ENABLED=false
KXRA_STAGING_CAPABILITY_PROFILE=
KXRA_EMAIL_WORKER_ORIGIN=
KXRA_EMAIL_WORKER_DATABASE_URL=
KXRA_EMAIL_WORKER_TRIGGER_SECRET=
KXRA_EMAIL_FROM=KXRA Group <notifications@REPLACE_WITH_VERIFIED_SUBDOMAIN>
# Exactly 32 random bytes encoded as base64url. Keep only in the OS and email
# worker secret stores; rotating it requires draining or replacing queued links.
KXRA_EMAIL_SECRET_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
POSTHOG_KEY=
SENTRY_DSN=
# Telemetry remains off until staging capture has passed the allowlist review.
KXRA_TELEMETRY_ENABLED=false
# Optional server-side Higgsfield prototype. Never use a NEXT_PUBLIC_ name and
# never place the value in Git, logs or chat. A one-off billable example also
# requires the exact local confirmation documented in the completion brief.
HF_CREDENTIALS=
KXRA_HIGGSFIELD_BILLABLE_CONFIRMATION=
