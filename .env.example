# No real credentials. npm run dev creates isolated local fixture configuration.
KXRA_AUTH_MODE=supabase
KXRA_ORIGIN=http://localhost:3210
KXRA_MARKETING_ORIGIN=http://localhost:3220
# Marketing has a narrow server-only public-ingress connection. In hosted
# environments use the dedicated least-privilege ingress role, never postgres,
# service_role or the private OS connection.
KXRA_PUBLIC_DATABASE_URL=
KXRA_PUBLIC_INGRESS_SECRET=REPLACE_WITH_GENERATED_SERVER_ONLY_SECRET
KXRA_PRIVATE_APP_URL=http://localhost:3210/login
# Independent server-only secret for encrypted join intents (at least 64 chars).
KXRA_JOIN_SECRET=REPLACE_WITH_GENERATED_SERVER_ONLY_SECRET
DATABASE_URL=postgresql://kxra_app:REPLACE_WITH_PRIVATE_ROLE_PASSWORD@localhost:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# Future integrations are disabled; do not add keys to client bundles.
KXRA_AI_ENABLED=false
KXRA_WHATSAPP_ENABLED=false
# Private Storage remains disabled until a private bucket and restricted worker
# database role are configured in staging. Never expose either secret to a client.
KXRA_STORAGE_ENABLED=false
KXRA_STORAGE_BUCKET=kxra-private
SUPABASE_STORAGE_SECRET_KEY=
KXRA_WORKER_DATABASE_URL=
# Restricted server-only connection whose login role may SET ROLE to
# kxra_ai_worker. The AI worker role itself is NOLOGIN and has only bounded
# execution-function grants.
KXRA_AI_WORKER_DATABASE_URL=
# Billing remains disabled until the exact test-mode activation is reviewed.
KXRA_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
TRIGGER_SECRET_KEY=
RESEND_API_KEY=
POSTHOG_KEY=
SENTRY_DSN=
