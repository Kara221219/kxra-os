{
  "name": "@kxra/os",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#kxra/github-connectors-page": {
      "development": "./components/GithubConnectionsPage.local.tsx",
      "default": "./components/CustomerConnections.production.tsx"
    },
    "#kxra/github-connectors-runtime": {
      "development": "./lib/github-connectors.local.ts",
      "default": "./lib/github-connectors.production.ts"
    },
    "#kxra/customer-connectors-page": {
      "development": "./components/CustomerConnectionsPage.local.tsx",
      "default": "./components/CustomerConnections.production.tsx"
    },
    "#kxra/customer-connectors-runtime": {
      "development": "./lib/customer-connectors.local.ts",
      "default": "./lib/customer-connectors.production.ts"
    },
    "#kxra/local-runtime": {
      "development": "./lib/local-runtime.ts",
      "default": "./lib/local-runtime.production.ts"
    },
    "#kxra/local-fixture-ui": {
      "development": "./components/LocalFixtureLogin.tsx",
      "default": "./components/LocalFixtureLogin.production.tsx"
    },
    "#kxra/paired-integration": {
      "development": "./lib/paired-integration.local.ts",
      "default": "./lib/paired-integration.production.ts"
    },
    "#kxra/paired-delegations-ui": {
      "development": "./components/PairedDelegations.tsx",
      "default": "./components/PairedDelegations.production.tsx"
    }
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3210",
    "preflight:staging": "node ../../scripts/verify-staging-config.mjs os",
    "build": "node ../../scripts/build-os.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3210"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "next": "16.4.3",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.2",
    "zod": "^4.1.5"
  }
}
