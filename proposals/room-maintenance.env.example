# Integration proposal only; no secret value is supplied or generated.
# Customer dispatch stays closed until exact room rollout + BYOK consent exists.
KXRA_HOSTED_ROOM_JOBS=false
# Separate reduction/health endpoint can remain on during an execution hold.
KXRA_ROOM_MAINTENANCE_ENABLED=false
KXRA_ROOM_WORKER_SECRET=
# Scheduler-only exact HTTPS origin; no path/query/credentials/trailing slash.
KXRA_ORIGIN=
